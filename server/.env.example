# StayMate AI Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/staymate_ai

# JWT Authentication
JWT_SECRET=staymate_ai_jwt_super_secret_key_development_only_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Client CORS Configuration
CLIENT_URL=http://localhost:5173
