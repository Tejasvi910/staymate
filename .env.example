# ===============================================
# StayMate AI – Environment Configuration Guide
# ===============================================

# -----------------------------------------------
# Backend Environment Variables (Render / Host)
# -----------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/staymate_ai?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=staymate_production_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_google_gemini_api_key

# Frontend Allowed Origin (Production Vercel URL or comma-separated URLs)
CLIENT_URL=https://staymate-ai.vercel.app

# -----------------------------------------------
# Frontend Environment Variables (Vercel)
# -----------------------------------------------
VITE_API_BASE_URL=https://staymate-backend-jn2s.onrender.com/api
